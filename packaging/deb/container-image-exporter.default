# Environment for container-image-exporter.service.
# Every option is also available as a CLI flag; flags take precedence.
# Apply changes with: systemctl restart container-image-exporter

EXPORTER_MODE=docker
EXPORTER_LISTEN_ADDRESS=:9877
# Empty uses DOCKER_HOST or the default socket /var/run/docker.sock.
#EXPORTER_DOCKER_HOST=unix:///var/run/docker.sock
#EXPORTER_KUBECONFIG=
#EXPORTER_SCAN_INTERVAL=1m
#EXPORTER_REGISTRY_INTERVAL=6h
#EXPORTER_REGISTRY_TIMEOUT=30s
#EXPORTER_REGISTRY_CONCURRENCY=4
#EXPORTER_LOG_LEVEL=info

# Registry authentication (all optional, public images need none).
# Docker Hub, GHCR, Quay, any registry: directory holding a Docker config.json
#DOCKER_CONFIG=/etc/container-image-exporter
# Amazon ECR: standard AWS SDK variables or an instance role
AWS_ECR_DISABLE_CACHE=true
#AWS_REGION=eu-west-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Google Artifact Registry / GCR: Application Default Credentials
#GOOGLE_APPLICATION_CREDENTIALS=/etc/container-image-exporter/gcp-key.json
# Azure Container Registry: service principal or managed identity
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
